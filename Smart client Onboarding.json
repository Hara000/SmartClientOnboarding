      "parameters": {
        "jsCode": "const output = $input.item.json.output;\nconst cleaned = output.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\nconst match = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('No JSON found in output');\nconst parsed = JSON.parse(match[0]);\nreturn { json: parsed };"
      },
